# Connection string "pooled" do Neon (host termina em "-pooler"), com os
# parâmetros abaixo pra funcionar com o Prisma. Usada em runtime pela app.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/cathan?sslmode=require&pgbouncer=true&connection_limit=1"

# Connection string "direta" do Neon (host SEM "-pooler"). Só o Prisma Migrate
# usa essa — PgBouncer em modo transaction não suporta os comandos de sessão
# que uma migration precisa.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/cathan?sslmode=require"

# Senha compartilhada do painel do quiosque (gate simples, ainda não é o sistema de perfis)
PAINEL_QUIOSQUE_SENHA="troque-esta-senha"

# Senha compartilhada do painel do gestor (gate simples, ainda não é o sistema de perfis)
PAINEL_GESTOR_SENHA="troque-esta-senha"

# Senha do Console Cathan (uso interno da equipe Cathan, não do gestor do evento)
PAINEL_ADMIN_SENHA="troque-esta-senha"

# Senha compartilhada da Venda Manual / Caixa do Evento (gate simples, mesma família das outras)
PAINEL_CAIXA_SENHA="troque-esta-senha"

# URL pública onde o app está acessível — usada nos back_urls/notification_url do Mercado Pago.
# Em desenvolvimento local, aponte para o túnel (ex: ngrok), não para localhost.
APP_URL="http://localhost:3000"

# Credenciais do Mercado Pago (Checkout Pro) — pegue em https://www.mercadopago.com.br/developers/panel
MP_ACCESS_TOKEN="TEST-xxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx"
MP_WEBHOOK_SECRET="troque-por-secret-da-notificacao-webhook"
